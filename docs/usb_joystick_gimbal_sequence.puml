@startuml
title Trinh tu xu ly USB joystick gimbal

skinparam backgroundColor white
skinparam shadowing false

actor Operator
participant "DR-1000" as USB
participant "Joystick" as Joystick
participant "QGCCameraManager" as Manager
participant "CodevCameraControl" as Camera
participant "Vehicle link" as Link
participant "R3 gimbal" as R3

Operator -> USB : Deflect pitch or yaw stick

loop Joystick polling
    USB -> Joystick : Raw axes 0 and 3
    Joystick -> Joystick : Apply calibration and deadband
    Joystick -> Joystick : Normalize to -1.0 through 1.0

    alt Stick outside deadband
        Joystick -> Manager : gimbalAxisControl(pitch, yaw)
        Manager -> Camera : gimbalAxisRateControl(pitch, yaw)
        Camera -> Camera : Convert input to PWM
        Camera -> Link : RC_CHANNELS, CH9 pitch, CH10 yaw
        Link -> R3 : Forward command
        R3 -> R3 : Move gimbal
    else Stick returned to center
        Joystick -> Manager : gimbalAxisControl(0, 0)
        Manager -> Camera : gimbalAxisRateControl(0, 0)
        Camera -> Link : RC_CHANNELS, CH9 and CH10 = 1500
        Link -> R3 : Stop command
        R3 -> R3 : Stop movement
    end
end

@enduml
